# El shell de VIDAA expone las teclas como codigos del mando. La tabla
# CONST.KEYCODE_MAP va de "codigo de mando" a "codigo de tecla", y al reves
# se puede deducir el codigo de mando a partir del nombre de la tecla.
JS_TECLA = """
(function(){
  var nombre = %(nombre)s;
  var clave = 'VK_' + nombre.toUpperCase();
  if (typeof CONST === 'undefined' || !CONST.KEY || CONST.KEY[clave] === undefined) {
    return 'error:la TV no tiene la tecla ' + clave;
  }
  var interno = CONST.KEY[clave];
  var mando = null;
  for (var i = 0; i < CONST.KEYCODE_MAP.length; i++) {
    if (CONST.KEYCODE_MAP[i] === interno) { mando = i; break; }
  }
  if (mando === null) { return 'error:no hay codigo de mando para ' + clave; }
  UI.onRemote({command: mando, state: 1, sendResult: function(){}});
  return 'ok:' + CONST.KEYVALUE_MAP[interno];
})()
"""

# Las fuentes de entrada se sacan de sourceMap (id <-> playId).
JS_FUENTES = """
(function(){
  var mapa = window.sourceMap || [];
  var nombres = window.LiveTVSourceMap || {};
  var actual = 0;
  try { actual = getCurrentSourceId(); } catch (e) {}
  var lista = [];
  for (var i = 0; i < mapa.length; i++) {
    lista.push([mapa[i].id, mapa[i].playId, mapa[i].playId === 'TV' ? 'Antena' : (mapa[i].playId || ''),
                mapa[i].id === actual ? 1 : 0]);
  }
  return JSON.stringify(lista);
})()
"""

JS_CAMBIA_FUENTE = """
(function(){
  var objetivo = %(fuente)s;
  var mapa = window.sourceMap || [];
  for (var i = 0; i < mapa.length; i++) {
    var p = mapa[i].playId || '';
    if (p.toLowerCase() === String(objetivo).toLowerCase() || String(mapa[i].id) === String(objetivo)) {
      changeSourceTo(mapa[i].id);
      return 'ok:' + p;
    }
  }
  return 'error:fuente desconocida';
})()
"""

# Los canales salen de liveTV.getChannelListOprtData().
JS_CANALES = """
(function(){
  if (typeof liveTV === 'undefined' || !liveTV.getChannelListOprtData) { return 'error:sin liveTV'; }
  var datos = liveTV.getChannelListOprtData();
  var todas = datos.allChannels || {};
  var lista = [];
  var actual = datos.crntList ? datos.crntList.name : '';
  for (var nombre in todas) {
    var canales = todas[nombre] || [];
    for (var i = 0; i < canales.length; i++) {
      lista.push([canales[i].number, canales[i].name, nombre, (nombre === actual &&
        datos.channelIndex === i) ? 1 : 0]);
    }
  }
  return JSON.stringify(lista);
})()
"""

JS_CAMBIA_CANAL = """
(function(){
  var objetivo = %(canal)s;
  var datos = liveTV.getChannelListOprtData();
  var todas = datos.allChannels || {};
  for (var lista in todas) {
    var canales = todas[lista] || [];
    for (var i = 0; i < canales.length; i++) {
      var c = canales[i];
      if (String(c.number) === String(objetivo) || String(c.name).toLowerCase() === String(objetivo).toLowerCase()) {
        checkAndPlayChannel(c);
        return 'ok:' + c.name;
      }
    }
  }
  return 'error:canal desconocido';
})()
"""


def cmd_hisense(args, config: Config) -> None:
    dispositivo = resolver(config, args.device, "hisense")
    cdp = CDP(dispositivo.ip, int(dispositivo.get("cdp_port", 9223)))
    accion = args.accion

    if accion == "apps":
        js = (
            "(function(){"
            "var lista=[];"
            "try{ if(window.appPagesList) lista=window.appPagesList.slice(); }catch(e){}"
            "if(!lista.length){ try{ lista=(typeof getRAppListWithIcon==='function')"
            "?(getRAppListWithIcon()||[]):[]; }catch(e){} }"
            "return JSON.stringify(lista);})()"
        )
        valor = cdp.js(js)
        try:
            lista = json.loads(valor or "[]")
        except json.JSONDecodeError:
            lista = []
        if isinstance(lista, dict):
            lista = list(lista)
        if not lista:
            die("la TV no ha devuelto la lista de apps")
        print("\n".join(str(item) for item in lista))

    elif accion == "launch":
        app = args.app
        alias = ALIAS_HISENSE.get(app.lower())
        if alias:
            app = alias
        estrategias = [
            f"startThirdPartyApp({json.dumps(app)})",
            f"openAppControl({json.dumps(app)})",
            f"startAppByRemoteControl({json.dumps(app)})",
            f"startHiPageApp({json.dumps(app)})",
        ]
        errores = []
        for js in estrategias:
            estado, valor = cdp.evaluar(js)
            if estado == "ok":
                print(f"'{app}' lanzado ({js.split('(')[0]})")
                return
            errores.append(f"{js.split('(')[0]}: {valor}")
        die("no se pudo lanzar la app. Se intentaron:\n  " + "\n  ".join(errores))

    elif accion == "shot":
        destino = args.destino or f"hisense-{time.strftime('%Y%m%d-%H%M%S')}.png"
        print(cdp.capturar(destino))

    elif accion == "source":
        if args.fuente in (None, "list"):
            valor = cdp.js(JS_FUENTES)
            filas = json.loads(valor or "[]")
            for identificador, play_id, nombre, activo in filas:
                marca = "*" if activo else " "
                print(f"{marca} {identificador:<4} {play_id:<12} {nombre}")
            return
        resultado = cdp.js(JS_CAMBIA_FUENTE % {"fuente": json.dumps(args.fuente)})
        if resultado.startswith("error:"):
            die(resultado[6:])
        # La TV aplica el cambio de forma asincrona: se espera a que la
        # fuente activa sea la nueva, o 'lanctl ver' leeria la anterior.
        objetivo = resultado[4:] if resultado.startswith("ok:") else args.fuente
        for _ in range(12):
            time.sleep(0.4)
            filas = json.loads(cdp.js(JS_FUENTES) or "[]")
            activas = [fila for fila in filas if fila[3]]
            if not activas:
                continue
            if str(activas[0][1]).lower() == str(objetivo).lower():
                break
        print(f"fuente cambiada a {args.fuente}")

    elif accion == "channels":
        valor = cdp.js(JS_CANALES)
        filas = json.loads(valor or "[]")
        for numero, nombre, lista, activo in filas:
            marca = "*" if activo else " "
            print(f"{marca} {str(numero):<6} {nombre:<24} ({lista})")

    elif accion == "channel":
        resultado = cdp.js(JS_CAMBIA_CANAL % {"canal": json.dumps(args.canal)})
        if resultado.startswith("error:"):
            die(resultado[6:])
        print(f"canal {args.canal} solicitado")

    elif accion == "power":
        if args.estado == "off":
            estado, valor = cdp.evaluar("switchOffTV()")
            print("TV apagada" if estado == "ok" else f"error: {valor}")
        else:
            estado, valor = cdp.evaluar("poweronByApp()")
            print("TV encendida" if estado == "ok" else f"error: {valor}")

    elif accion == "cast":
        print(DLNA(dispositivo.ip).reproducir(args.url, args.titulo))

    elif accion == "eval":
        valor = cdp.js(args.js)
        if isinstance(valor, (dict, list)):
            valor = json.dumps(valor, ensure_ascii=False, indent=2)
        print(valor if valor is not None else "(sin valor)")

    elif accion == "key":
        resultado = cdp.js(JS_TECLA % {"nombre": json.dumps(args.tecla)})
        if resultado.startswith("error:"):
            die(resultado[6:])
        print(f"tecla '{args.tecla}' enviada")


# ------------------------------------------------------------- firetv


def _servicio(nombre: str) -> dict:
    """Busca un servicio de streaming por su nombre."""
    clave = nombre.lower().strip().replace(" ", "")
    clave = SERVICIOS_ALIAS.get(clave, clave)
    servicio = SERVICIOS.get(clave)
    if not servicio:
        die(f"servicio desconocido '{nombre}'. Conocidos: "
            f"{', '.join(sorted(set(SERVICIOS) | set(SERVICIOS_ALIAS)))}")
    return servicio


def _parece_id(texto: str) -> bool:
    """Distingue un identificador de titulo de un nombre de peli.

    Los ids son numericos (Netflix, Twitch), UUID con guiones (Disney+) o
    codigos alfanumericos (YouTube, Crunchyroll). Un nombre de peli no suele
    tener numeros ni guiones.
    """
    limpio = texto.strip()
    if not limpio or " " in limpio:
        return False
    if limpio.isdigit():
        return True
    if "-" in limpio:
        return True
    return len(limpio) >= 8 and any(c.isdigit() for c in limpio) and any(
        c.isalpha() for c in limpio)


def _youtube_desde_titulo(texto: str) -> str | None:
    """Busca en YouTube el primer vídeo que coincide y devuelve su id.

    YouTube es el único servicio de los de aquí que trae los ids en el
    HTML de los resultados, así que es el único que se puede resolver
    solo. En los demás hay que pasarle el id (o el nombre, y se abre el
    buscador para elegir con el mando).
    """
    url = "https://www.youtube.com/results?search_query=" + urllib.parse.quote(texto.strip())
    cabeceras = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
                               "(KHTML, like Gecko) Chrome/126.0 Safari/537.36"}
    try:
        pagina = http_get(url, timeout=12, cabeceras=cabeceras).decode("utf-8", "replace")
    except Exception:
        return None
    encontrado = re.search(r'"videoId":"([A-Za-z0-9_-]{11})"', pagina)
    return encontrado.group(1) if encontrado else None


def _firetv_play(adb: Adb, nombre: str, destino: str) -> None:
    """Abre un titulo concreto en un servicio de streaming."""
    servicio = _servicio(nombre)
    paquete = servicio["paquete"]
    destino = destino.strip()
    if "://" in destino:
        url = destino
    elif _parece_id(destino):
        url = servicio["titulo"].replace("{id}", destino)
    else:
        # No es un id: es el nombre de la peli. YouTube se resuelve solo; en
        # los demas se abre el buscador del servicio y se elige con el mando.
        if nombre == "youtube":
            identificador = _youtube_desde_titulo(destino)
            if identificador:
                print(f"'{destino}' resuelto en YouTube: {identificador}")
                url = servicio["titulo"].replace("{id}", identificador)
            else:
                print(f"no se ha podido resolver '{destino}': abro el buscador")
                _firetv_buscar(adb, nombre, destino, False)
                return
        else:
            print(f"'{destino}' no parece un id: abro el buscador de {nombre}")
            _firetv_buscar(adb, nombre, destino, False)
            return
    adb.despierte()
    adb.abrir_url(url, paquete)
    actual = adb.esperar_foco(paquete, 8.0)
    print(f"abriendo {url}")
    if actual != paquete:
        warn(f"la app '{paquete}' no tiene el foco (esta en '{actual or '?'}')")
        return
    # Las apps de streaming arrancan de forma asincrona: puede que deep link
    # haya abierto la ficha del titulo pero que todavia no este sonando. Se
    # espera a la sesion multimedia y, si no arranca, se pulsa OK.
    estado = adb.esperar_reproduccion(paquete, 8.0)
    if estado == 3:
        print("reproduciendo")
        return
    print("no ha arrancado solo: pulso OK")
    adb.teclas("enter")
    if adb.esperar_reproduccion(paquete, 10.0) == 3:
        print("reproduciendo")
    else:
        warn("no se ha podido confirmar la reproduccion: comprueba la pantalla")


def _firetv_buscar(adb: Adb, nombre: str, texto: str, pulsa_ok: bool) -> None:
    """Abre el buscador de un servicio con un texto."""
    servicio = _servicio(nombre)
    paquete = servicio["paquete"]
    # %20 y no +: en un camino (twitch://search/...) el signo + es literal.
    consulta = urllib.parse.quote(texto.strip(), safe="")
    url = servicio["buscar"].replace("{q}", consulta)
    adb.despierte()
    adb.abrir_url(url, paquete)
    actual = adb.esperar_foco(paquete, 8.0)
    print(f"buscando '{texto}' en {nombre}: {url}")
    if actual != paquete:
        warn(f"la app '{paquete}' no tiene el foco (esta en '{actual or '?'}')")
        return
    if pulsa_ok:
        time.sleep(2.0)
        adb.teclas("enter")
        print("pulsado OK en el primer resultado")


def cmd_firetv(args, config: Config) -> None:
    dispositivo = resolver(config, args.device, "firetv")
    adb = Adb(dispositivo)
    adb.listo()
    accion = args.accion

    if accion == "apps":
        for app in adb.listar_apps(solo_terceros=args.terceros):
            print(app)
    elif accion == "launch":
        destino = args.destino
        alias = ALIAS_FIRETV.get(destino.lower())
        if alias:
            destino = alias
        print(adb.lanzar(destino))
        # Se espera a que la app tenga el foco: 'lanctl ver' lo lee justo
        # despues y tiene que ser coherente.
        if "://" not in destino and "." in destino:
            actual = adb.esperar_foco(destino)
            if actual != destino:
                warn(f"el foco sigue en '{actual or '?'}'")
    elif accion == "stop":
        print(adb.shell("am", "force-stop", args.destino))
    elif accion == "key":
        adb.teclas(args.tecla)
        print(f"tecla '{args.tecla}' enviada")
    elif accion == "text":
        adb.texto(args.texto)
        print("texto enviado")
    elif accion == "shot":
        destino = args.destino or f"firetv-{time.strftime('%Y%m%d-%H%M%S')}.png"
        print(adb.captura(destino))
    elif accion == "shell":
        print(adb.shell(*args.comando))
    elif accion == "install":
        if not args.si:
            die("instalar modifica el dispositivo: vuelve a ejecutarlo con --si")
        print(adb.instalar(args.paquete))
    elif accion == "volume":
        print(adb.volumen(args.nivel))
    elif accion == "power":
        print(adb.energia(args.estado))
    elif accion == "play":
        _firetv_play(adb, args.servicio, args.destino)
    elif accion == "buscar":
        _firetv_buscar(adb, args.servicio, args.texto, args.ok)
    elif accion == "info":
        for clave, valor in adb.estado().items():
            print(f"{clave}={valor}")


# --------------------------------------------------------------- atajos
#
# Todo lo que viene a continuacion son atajos de uso diario: resumen del
# estado, capturas, escenas ya montadas y un mando unificado para las dos
# TVs.


JS_VER = """
(function(){
  var salida = {};
  var mapa = window.sourceMap || [];
  var actual = 0;
  try { actual = getCurrentSourceId(); } catch (e) {}
  salida.fuente_id = actual;
  salida.fuente = '';
  for (var i = 0; i < mapa.length; i++) {
    if (mapa[i].id === actual) { salida.fuente = mapa[i].playId || ''; }
  }
  try {
    var datos = liveTV.getChannelListOprtData();
    salida.canal = (datos && datos.crntList && datos.crntList.name) || '';
  } catch (e) { salida.canal = ''; }
  try { salida.modulo = getCurrentSubModelName() || ''; } catch (e) { salida.modulo = ''; }
  return JSON.stringify(salida);
})()
"""


def _dispositivos_de(config: Config, tipo: str) -> list[Dispositivo]:
    """Todos los dispositivos de un tipo, sin morir si no hay ninguno."""
    return [Dispositivo(clave, datos)
            for clave, datos in config.dispositivos.items()
            if datos.get("type") == tipo]


def _ns(**campos) -> argparse.Namespace:
    """Namespace de argparse con los campos justos para un comando."""
    return argparse.Namespace(**campos)


def _ver_firetv(dispositivo: Dispositivo) -> dict:
    info = {"clave": dispositivo.clave, "ip": dispositivo.ip}
    try:
        adb = Adb(dispositivo)
        adb.listo()
        paquete = adb.foco_actual()
        despierto = "despierta=True" in adb.energia("estado")
        info["app"] = NOMBRE_AMIGABLE.get(paquete, paquete)
        info["paquete"] = paquete
        info["estado"] = "despierta" if despierto else "en reposo"
    except SystemExit:
        info["estado"] = "no contesta"
    return info


def _ver_hisense(dispositivo: Dispositivo) -> dict:
    info = {"clave": dispositivo.clave, "ip": dispositivo.ip}
    try:
        cdp = CDP(dispositivo.ip, int(dispositivo.get("cdp_port", 9223)))
        datos = json.loads(cdp.js(JS_VER) or "{}")
    except (SystemExit, json.JSONDecodeError):
        info["estado"] = "no contesta"
        return info
    info["fuente"] = datos.get("fuente") or f"id {datos.get('fuente_id')}"
    info["canal"] = datos.get("canal") or ""
    info["modulo"] = datos.get("modulo") or ""
    info["estado"] = "encendida"
    return info


def cmd_ver(args, config: Config) -> None:
    """Que se ve ahora en cada dispositivo."""
    filas = []
    for dispositivo in _dispositivos_de(config, "firetv"):
        info = _ver_firetv(dispositivo)
        app = info.get("app") or "?"
        if info.get("paquete"):
            app = f"{app} ({info['paquete']})"
        filas.append([info["clave"], info["ip"], app, info["estado"]])
    for dispositivo in _dispositivos_de(config, "hisense"):
        info = _ver_hisense(dispositivo)
        detalle = info.get("fuente", "?")
        if info.get("canal"):
            detalle += f", canal {info['canal']}"
        if info.get("modulo"):
            detalle += f", {info['modulo']}"
        filas.append([info["clave"], info["ip"], detalle, info["estado"]])
    if not filas:
        die("no hay ningun dispositivo conocido (prueba 'lanctl discover')")
    print(tabla(filas, ["clave", "ip", "que se ve", "estado"]))


def cmd_foto(args, config: Config) -> None:
    """Captura la pantalla de las TVs."""
    destino = Path(args.destino).expanduser() if args.destino else Path.home() / "Capturas"
    marca = time.strftime("%Y%m%d-%H%M%S")
    destino.mkdir(parents=True, exist_ok=True)
    hechas = []
    for dispositivo in _dispositivos_de(config, "hisense"):
        ruta = destino / f"{marca}-{dispositivo.clave}.png"
        try:
            cdp = CDP(dispositivo.ip, int(dispositivo.get("cdp_port", 9223)))
            cdp.capturar(str(ruta))
        except SystemExit:
            warn(f"{dispositivo.clave}: no se pudo capturar (no responde)")
            continue
        hechas.append(str(ruta))
        print(f"{dispositivo.clave:<10} {ruta}")
    for dispositivo in _dispositivos_de(config, "firetv"):
        ruta = destino / f"{marca}-{dispositivo.clave}.png"
        try:
            adb = Adb(dispositivo)
            adb.listo()
            adb.captura(str(ruta))
        except SystemExit:
            warn(f"{dispositivo.clave}: no se pudo capturar (pantalla protegida "
                 "por DRM o sin respuesta)")
            continue
        hechas.append(str(ruta))
        print(f"{dispositivo.clave:<10} {ruta}")
    if not hechas:
        die("no se pudo capturar ninguna pantalla")


def _paso_firetv(accion: str, valor: str, config: Config) -> None:
    campos = {"device": None, "accion": accion}
    if accion == "launch":
        campos["destino"] = valor
    elif accion == "power":
        campos["estado"] = valor
    cmd_firetv(_ns(**campos), config)


def _paso_hisense(accion: str, valor: str, config: Config) -> None:
    campos = {"device": None, "accion": accion}
    if accion == "source":
        campos["fuente"] = valor
    elif accion == "power":
        campos["estado"] = valor
    cmd_hisense(_ns(**campos), config)


def cmd_escena(args, config: Config) -> None:
    """Ejecuta una escena ya montada (netflix, antena, apagar...)."""
    pasos = ESCENAS.get(args.escena.lower())
    if not pasos:
        die(f"no conozco la escena '{args.escena}'. "
            f"Conocidas: {', '.join(sorted(ESCENAS))}")
    for tipo, accion, valor in pasos:
        if tipo == "firetv":
            _paso_firetv(accion, valor, config)
        else:
            _paso_hisense(accion, valor, config)


def cmd_mando(args, config: Config) -> None:
    """Manda la misma tecla a una o a las dos TVs."""
    equivalencias = TECLAS_UNIFICADAS.get(args.tecla.lower())
    if not equivalencias:
        die(f"tecla desconocida '{args.tecla}'. "
            f"Comunes: {', '.join(sorted(TECLAS_UNIFICADAS))}")
    adb_tecla, tv_tecla = equivalencias
    destino = (args.destino or "todas").lower()
    if destino not in ("firetv", "hisense", "todas", "ambas", "las dos"):
        die("destino: firetv, hisense o todas")

    enviados = []
    if destino in ("firetv", "todas", "ambas", "las dos"):
        for dispositivo in _dispositivos_de(config, "firetv"):
            try:
                adb = Adb(dispositivo)
                adb.listo()
                adb.teclas(adb_tecla)
            except SystemExit:
                warn(f"{dispositivo.clave}: no se pudo enviar la tecla")
                continue
            enviados.append(f"{dispositivo.clave} ({adb_tecla})")
    if destino in ("hisense", "todas", "ambas", "las dos"):
        for dispositivo in _dispositivos_de(config, "hisense"):
            try:
                cdp = CDP(dispositivo.ip, int(dispositivo.get("cdp_port", 9223)))
                resultado = cdp.js(JS_TECLA % {"nombre": json.dumps(tv_tecla)})
            except SystemExit:
                warn(f"{dispositivo.clave}: no se pudo enviar la tecla")
                continue
            if isinstance(resultado, str) and resultado.startswith("error:"):
                warn(f"{dispositivo.clave}: {resultado[6:]}")
                continue
            enviados.append(f"{dispositivo.clave} ({tv_tecla})")
    if not enviados:
        die("no se pudo enviar la tecla a ningun dispositivo")
    print("tecla enviada a: " + ", ".join(enviados))


def cmd_fuente(args, config: Config) -> None:
    """Atajo de 'hisense source'."""
    cmd_hisense(_ns(device=None, accion="source", fuente=args.fuente), config)


def cmd_canal(args, config: Config) -> None:
    """Atajo de 'hisense channel'."""
    cmd_hisense(_ns(device=None, accion="channel", canal=args.canal), config)


def cmd_volumen(args, config: Config) -> None:
    """Atajo de 'firetv volume'."""
    cmd_firetv(_ns(device=None, accion="volume", nivel=args.nivel), config)


def cmd_play(args, config: Config) -> None:
    """Atajo de 'firetv play': abre un titulo en un servicio de streaming."""
    cmd_firetv(_ns(device=None, accion="play", servicio=args.servicio,
                    destino=args.destino), config)


def cmd_buscar(args, config: Config) -> None:
    """Atajo de 'firetv buscar': abre el buscador de un servicio."""
    cmd_firetv(_ns(device=None, accion="buscar", servicio=args.servicio,
                    texto=args.texto, ok=args.ok), config)


# ------------------------------------------------------------- iphone


def cmd_iphone(args, config: Config) -> None:
    if args.accion == "list":
        encontrados = [(clave, datos) for clave, datos in sorted(config.dispositivos.items())
                        if datos.get("type") == "iphone"]
        if not encontrados:
            die("no hay ningun iPhone guardado en la configuracion")
        for clave, datos in encontrados:
            print(Ios(Dispositivo(clave, datos)).estado())
            print()
        return
    dispositivo = resolver(config, args.device, "iphone")
    ios = Ios(dispositivo)
    if args.accion == "info":
        print(ios.info())
    elif args.accion == "shot":
        destino = args.destino or f"iphone-{time.strftime('%Y%m%d-%H%M%S')}.png"
        print(ios.captura(destino))


# ------------------------------------------------------------- router


def cmd_router(args, config: Config) -> None:
    dispositivo = resolver(config, args.device, "router")
    ubus = Ubus(dispositivo.ip, dispositivo.get("ssh_user") or "root")
    ubus.entrar()
    if args.accion == "uci":
        for linea in ubus.uci(args.seccion, args.opcion):
            print(linea)
    elif args.accion == "call":
        print(ubus.llamar(args.objeto, args.metodo, {}))
    else:
        print(ubus.llamar("system", "board", {}))


# --------------------------------------------------------------- parser


def anadir_device(parser: argparse.ArgumentParser) -> argparse.ArgumentParser:
    parser.add_argument("--device", help="clave del dispositivo (por defecto, el unico de su tipo)")
    return parser


def construir_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=APP,
        description="Control de dispositivos concretos de la red local.",
    )
    parser.add_argument("--version", action="version", version=f"{APP} {VERSION}")
    sub = parser.add_subparsers(dest="comando", required=True)

    p = sub.add_parser("discover", help="escanea la red y guarda el inventario")
    p.add_argument("--cidr", help="red a escanear (por defecto, la local /24)")
    p.add_argument("--ports", type=int, nargs="+", help="puertos a sondear")
    p.add_argument("--rapido", action="store_true",
                   help="solo sondea los puertos clave (mucho mas rapido)")
    p.set_defaults(func=cmd_discover)

    p = sub.add_parser("ls", help="lista los dispositivos del inventario")
    p.set_defaults(func=cmd_ls)

    p = sub.add_parser("status", help="detalle de un dispositivo")
    p.add_argument("dispositivo", nargs="?", help="clave, nombre o IP")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("ip", help="imprime la IP de un dispositivo")
    p.add_argument("dispositivo", nargs="?")
    p.set_defaults(func=cmd_ip)

    p = sub.add_parser("ping", help="hace ping a un dispositivo")
    p.add_argument("dispositivo")
    p.add_argument("--cuenta", type=int, default=4)
    p.set_defaults(func=cmd_ping)

    p = sub.add_parser("ssh", help="se conecta por ssh a un dispositivo")
    p.add_argument("dispositivo")
    p.add_argument("comando", nargs="*")
    p.set_defaults(func=cmd_ssh)

    p = sub.add_parser("wake", help="despierta un equipo con un magic packet")
    p.add_argument("dispositivo")
    p.set_defaults(func=cmd_wake)

    p = sub.add_parser("raw", help="manda texto crudo a un puerto")
    p.add_argument("dispositivo")
    p.add_argument("puerto", type=int)
    p.add_argument("carga", nargs="*")
    p.set_defaults(func=cmd_raw)

    p = sub.add_parser("setup", help="prepara adb y la config sin ser root")
    p.add_argument("--forzar", action="store_true", help="vuelve a instalar aunque exista")
    p.set_defaults(func=cmd_setup)

    p = sub.add_parser("doctor", help="comprueba que todo esta en su sitio")
    p.set_defaults(func=cmd_doctor)

    # --- atajos ----------------------------------------------------------
    p = sub.add_parser("ver", help="que se ve ahora en cada dispositivo")
    p.set_defaults(func=cmd_ver)

    p = sub.add_parser("foto", help="captura la pantalla de las TVs")
    p.add_argument("destino", nargs="?", help="directorio donde dejarlas")
    p.set_defaults(func=cmd_foto)

    p = sub.add_parser("escena", help="atajos combinados (netflix, antena, apagar...)")
    p.add_argument("escena")
    p.set_defaults(func=cmd_escena)

    p = sub.add_parser("mando", help="manda una tecla a una o a las dos TVs")
    p.add_argument("tecla")
    p.add_argument("destino", nargs="?", default="todas",
                   help="firetv, hisense o todas (por defecto, todas)")
    p.set_defaults(func=cmd_mando)

    p = sub.add_parser("fuente", help="cambia de fuente en la TV Hisense")
    p.add_argument("fuente", nargs="?", help="hdmi1, tv, av... (sin argumento: lista)")
    p.set_defaults(func=cmd_fuente)

    p = sub.add_parser("canal", help="cambia de canal en la TV Hisense")
    p.add_argument("canal")
    p.set_defaults(func=cmd_canal)

    p = sub.add_parser("volumen", help="volumen del Fire TV")
    p.add_argument("nivel", help="up, down, mute o 0-100")
    p.set_defaults(func=cmd_volumen)

    p = sub.add_parser("play", help="abre un titulo en un servicio de streaming")
    p.add_argument("servicio", help="netflix, disney, hbo, twitch, youtube, crunchyroll")
    p.add_argument("destino", help="id del titulo, URL o nombre (busca)")
    p.set_defaults(func=cmd_play)

    p = sub.add_parser("buscar", help="abre el buscador de un servicio de streaming")
    p.add_argument("servicio", help="netflix, disney, hbo, twitch, youtube, crunchyroll")
    p.add_argument("texto", help="lo que se busca")
    p.add_argument("--ok", action="store_true", help="pulsa OK en el primer resultado")
    p.set_defaults(func=cmd_buscar)

    # --- hisense ---------------------------------------------------------
    p = sub.add_parser("hisense", help="maneja la TV Hisense (VIDAA)")
    hsub = p.add_subparsers(dest="accion", required=True)
    anadir_device(hsub.add_parser("apps", help="lista las apps disponibles"))
    h = anadir_device(hsub.add_parser("launch", help="lanza una app"))
    h.add_argument("app", help="id de app: youtube, netflix, amazon, opera4x...")
    h = anadir_device(hsub.add_parser("shot", help="captura la pantalla"))
    h.add_argument("destino", nargs="?", help="fichero png de salida")
    h = anadir_device(hsub.add_parser("source", help="cambia de fuente de entrada"))
    h.add_argument("fuente", nargs="?", help="hdmi1, tv, av... (sin argumento: lista las fuentes)")
    anadir_device(hsub.add_parser("channels", help="lista los canales"))
    h = anadir_device(hsub.add_parser("channel", help="cambia de canal"))
    h.add_argument("canal", help="numero o nombre de canal")
    h = anadir_device(hsub.add_parser("power", help="apaga o enciende la TV"))
    h.add_argument("estado", nargs="?", choices=["on", "off"], default="off")
    h = anadir_device(hsub.add_parser("cast", help="manda un video por DLNA"))
    h.add_argument("url")
    h.add_argument("--titulo", default="lanctl")
    h = anadir_device(hsub.add_parser("eval", help="ejecuta JavaScript en la TV"))
    h.add_argument("js")
    h = anadir_device(hsub.add_parser("key", help="envia una tecla"))
    h.add_argument("tecla")
    # Cada alias de app es tambien un subcomando: 'lanctl hisense netflix'.
    for alias, app in ALIAS_HISENSE.items():
        h = anadir_device(hsub.add_parser(alias, help=f"lanza la app {app}"))
        h.set_defaults(func=cmd_hisense, accion="launch", app=app)
    p.set_defaults(func=cmd_hisense)

    # --- firetv ----------------------------------------------------------
    p = sub.add_parser("firetv", help="maneja el Fire TV Stick por ADB")
    fsub = p.add_subparsers(dest="accion", required=True)
    h = anadir_device(fsub.add_parser("apps", help="lista las apps instaladas"))
    h.add_argument("--terceros", action="store_true", help="solo las instaladas por ti")
    h = anadir_device(fsub.add_parser("launch", help="lanza una app o una url"))
    h.add_argument("destino", help="paquete (com.netflix...) o url")
    h = anadir_device(fsub.add_parser("stop", help="fuerza el cierre de una app"))
    h.add_argument("destino", help="paquete")
    h = anadir_device(fsub.add_parser("key", help="envia una tecla"))
    h.add_argument("tecla", help="home, back, up, down, left, right, enter, menu, play...")
    h = anadir_device(fsub.add_parser("text", help="escribe texto"))
    h.add_argument("texto")
    h = anadir_device(fsub.add_parser("shot", help="captura la pantalla"))
    h.add_argument("destino", nargs="?", help="fichero png de salida")
    h = anadir_device(fsub.add_parser("shell", help="ejecuta un comando en el dispositivo"))
    h.add_argument("comando", nargs=argparse.REMAINDER)
    h = anadir_device(fsub.add_parser("install", help="instala un apk"))
    h.add_argument("paquete", help="ruta del apk")
    h.add_argument("--si", action="store_true", help="no pedir confirmacion")
    h = anadir_device(fsub.add_parser("volume", help="sube, baja o silencia"))
    h.add_argument("nivel", help="up, down, mute o 0-100")
    h = anadir_device(fsub.add_parser("power", help="suspende o despierta"))
    h.add_argument("estado", nargs="?", choices=["on", "off"], default="on")
    anadir_device(fsub.add_parser("info", help="informacion del sistema"))
    h = anadir_device(fsub.add_parser("play", help="abre un titulo de un servicio"))
    h.add_argument("servicio", help="netflix, disney, hbo, twitch, youtube, crunchyroll")
    h.add_argument("destino", help="id del titulo, URL o nombre (busca)")
    h = anadir_device(fsub.add_parser("buscar", help="abre el buscador de un servicio"))
    h.add_argument("servicio", help="netflix, disney, hbo, twitch, youtube, crunchyroll")
    h.add_argument("texto", help="lo que se busca")
    h.add_argument("--ok", action="store_true", help="pulsa OK en el primer resultado")
    # Cada alias de app es tambien un subcomando: 'lanctl firetv netflix'.
    for alias, paquete in ALIAS_FIRETV.items():
        h = anadir_device(fsub.add_parser(alias, help=f"lanza {paquete}"))
        h.set_defaults(func=cmd_firetv, accion="launch", destino=paquete)
    p.set_defaults(func=cmd_firetv)

    # --- iphone ----------------------------------------------------------
    p = sub.add_parser("iphone", help="info del iPhone en la red")
    isub = p.add_subparsers(dest="accion", required=True)
    anadir_device(isub.add_parser("list", help="lista los iPhone anunciados"))
    anadir_device(isub.add_parser("info", help="modelo, iOS, capacidad"))
    h = anadir_device(isub.add_parser("shot", help="captura la pantalla"))
    h.add_argument("destino", nargs="?", help="fichero png de salida")
    p.set_defaults(func=cmd_iphone)

    # --- router ----------------------------------------------------------
    p = sub.add_parser("router", help="router OpenWrt por ubus (necesita credenciales)")
    rsub = p.add_subparsers(dest="accion", required=True)
    anadir_device(rsub.add_parser("board", help="informacion del sistema"))
    h = anadir_device(rsub.add_parser("uci", help="lee una seccion de la configuracion"))
    h.add_argument("seccion")
    h.add_argument("opcion", nargs="?")
    h = anadir_device(rsub.add_parser("call", help="llama a un objeto de ubus"))
    h.add_argument("--objeto", default="system")
    h.add_argument("--metodo", default="board")
    p.set_defaults(func=cmd_router)

    return parser


def main() -> None:
    parser = construir_parser()
    args = parser.parse_args()
    config = Config()
    try:
        args.func(args, config)
    except KeyboardInterrupt:
        print()
        sys.exit(130)


if __name__ == "__main__":
    main()
