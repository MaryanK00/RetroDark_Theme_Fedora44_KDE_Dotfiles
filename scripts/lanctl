# --------------------------------------------------------------------- salida


def log(msg: str = "") -> None:
    print(msg)


def warn(msg: str) -> None:
    print(f"AVISO: {msg}", file=sys.stderr)


def die(msg: str, code: int = 1):
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


def tabla(filas: list[list[str]], cabeceras: list[str]) -> str:
    if not filas:
        return ""
    anchos = [len(h) for h in cabeceras]
    for fila in filas:
        for i, celda in enumerate(fila):
            anchos[i] = max(anchos[i], len(str(celda)))
    lineas = ["  ".join(h.ljust(anchos[i]) for i, h in enumerate(cabeceras)).rstrip()]
    lineas.append("  ".join("-" * anchos[i] for i in range(len(cabeceras))))
    for fila in filas:
        lineas.append("  ".join(str(c).ljust(anchos[i]) for i, c in enumerate(fila)).rstrip())
    return "\n".join(lineas)


# ----------------------------------------------------------------- procesos


def run(cmd: list[str], timeout: int = 25, check: bool = False, texto: bool = True):
    """Ejecuta un comando y devuelve el CompletedProcess."""
    try:
        proc = subprocess.run(cmd, capture_output=True, text=texto, timeout=timeout)
    except FileNotFoundError:
        die(f"falta el programa '{cmd[0]}'")
    except subprocess.TimeoutExpired:
        die(f"'{cmd[0]}' no termino a tiempo ({timeout}s)")
    if check and proc.returncode != 0:
        detalle = (proc.stderr or proc.stdout or "").strip() if texto else ""
        die(f"'{cmd[0]}' fallo (rc={proc.returncode}): {detalle}")
    return proc


def tiene(programa: str) -> bool:
    return shutil.which(programa) is not None


# ------------------------------------------------------------------- red


def opener_sin_proxy() -> urllib.request.OpenerDirector:
    """Abre HTTP ignorando cualquier proxy del entorno: esto es red local."""
    return urllib.request.build_opener(urllib.request.ProxyHandler({}))


def http_get(url: str, timeout: int = 8, cabeceras: dict | None = None) -> bytes:
    peticion = urllib.request.Request(url, headers=cabeceras or {"User-Agent": f"{APP}/{VERSION}"})
    with opener_sin_proxy().open(peticion, timeout=timeout) as resp:
        return resp.read()


def http_post(url: str, cuerpo: bytes, timeout: int = 8, cabeceras: dict | None = None) -> bytes:
    cab = {"User-Agent": f"{APP}/{VERSION}", "Content-Type": 'text/xml; charset="utf-8"'}
    cab.update(cabeceras or {})
    peticion = urllib.request.Request(url, data=cuerpo, headers=cab, method="POST")
    with opener_sin_proxy().open(peticion, timeout=timeout) as resp:
        return resp.read()


def puerto_abierto(host: str, puerto: int, timeout: float = 1.2) -> bool:
    try:
        with socket.create_connection((host, puerto), timeout=timeout):
            return True
    except OSError:
        return False


def ip_local() -> str | None:
    """IP de este equipo en la LAN, sacada de la tabla de rutas."""
    proc = run(["ip", "-4", "route", "get", "1.1.1.1"], timeout=5)
    coincidencia = re.search(r"\ssrc\s+(\d+\.\d+\.\d+\.\d+)", proc.stdout or "")
    return coincidencia.group(1) if coincidencia else None


def red_local(ip: str | None = None) -> str:
    """Supone /24, que es lo habitual en un router domestico."""
    ip = ip or ip_local() or "192.168.1.150"
    partes = ip.split(".")
    return f"{partes[0]}.{partes[1]}.{partes[2]}.0/24"


def tabla_vecinos() -> dict[str, str]:
    """Mapa IP -> MAC de la tabla ARP del kernel."""
    vecinos: dict[str, str] = {}
    proc = run(["ip", "neigh", "show"], timeout=5)
    for linea in (proc.stdout or "").splitlines():
        partes = linea.split()
        if len(partes) < 4 or "lladdr" not in partes:
            continue
        mac = partes[partes.index("lladdr") + 1]
        if re.fullmatch(r"[0-9a-f]{2}(:[0-9a-f]{2}){5}", mac):
            vecinos[partes[0]] = mac
    return vecinos


def escanear_nmap(cidr: str, puertos: list[int]) -> list[dict]:
    """Connect-scan: funciona sin root y ve los equipos que no responden a ICMP."""
    if not tiene("nmap"):
        die("falta nmap (dnf install nmap)")
    lista = ",".join(str(p) for p in sorted(puertos))
    cmd = ["nmap", "-sT", "-n", "-Pn", "--open", "-T4", "--max-retries", "1",
           "-p", lista, "-oX", "-", cidr]
    proc = run(cmd, timeout=240)
    salida = proc.stdout or ""
    inicio = salida.find("<?xml")
    if inicio < 0:
        return []
    try:
        raiz = ET.fromstring(salida[inicio:])
    except ET.ParseError:
        return []
    equipos = []
    for host in raiz.findall("host"):
        direccion = None
        mac = None
        for addr in host.findall("address"):
            if addr.get("addrtype") == "ipv4":
                direccion = addr.get("addr")
            elif addr.get("addrtype") == "mac":
                mac = addr.get("addr")
        if not direccion:
            continue
        abiertos = []
        for puerto in host.findall("ports/port"):
            if puerto.get("state") == "open":
                abiertos.append(int(puerto.get("portid")))
        equipos.append({"ip": direccion, "mac": mac, "ports": sorted(abiertos)})
    return equipos


def buscar_ssdp(st: str = "ssdp:all", segundos: float = 3.0) -> list[dict]:
    """M-SEARCH por multicast. Descubre equipos que no responden a ping."""
    peticion = (
        "M-SEARCH * HTTP/1.1\r\n"
        "HOST: 239.255.255.250:1900\r\n"
        'MAN: "ssdp:discover"\r\n'
        f"MX: {int(segundos)}\r\n"
        f"ST: {st}\r\n"
        "\r\n"
    ).encode()
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    encontrados: list[dict] = []
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 4)
        sock.settimeout(0.4)
        sock.sendto(peticion, ("239.255.255.250", 1900))
        limite = time.time() + segundos
        while time.time() < limite:
            try:
                datos, _ = sock.recvfrom(4096)
            except socket.timeout:
                continue
            texto = datos.decode("utf-8", "replace")
            cabecera = {}
            for linea in texto.split("\r\n")[1:]:
                if ":" in linea:
                    clave, _, valor = linea.partition(":")
                    cabecera[clave.strip().lower()] = valor.strip()
            ubicacion = cabecera.get("location")
            if ubicacion and ubicacion not in [e.get("location") for e in encontrados]:
                encontrados.append(cabecera)
    except OSError:
        pass
    finally:
        sock.close()
    return encontrados


def buscar_mdns() -> list[dict]:
    """Servicios anunciados por mDNS, con su hostname, direccion y puerto."""
    if not tiene("avahi-browse"):
        return []
    proc = run(["avahi-browse", "-art"], timeout=15)
    servicios: list[dict] = []
    actual: dict | None = None
    for linea in (proc.stdout or "").splitlines():
        if linea.startswith("="):
            partes = linea.split()
            actual = None
            if len(partes) >= 4 and partes[3] in SERVICIOS_MDNS:
                actual = {"tipo": partes[3], "hostname": partes[2],
                          "direccion": None, "puerto": None, "txt": ""}
                servicios.append(actual)
        elif linea.startswith(" ") and actual is not None:
            clave, _, valor = linea.strip().partition("=")
            if clave == "address":
                actual["direccion"] = valor.strip("[]").split(",")[0]
            elif clave == "port":
                texto = valor.strip("[]")
                actual["puerto"] = int(texto) if texto.isdigit() else None
            elif clave == "txt":
                actual["txt"] = valor.strip()
    return [s for s in servicios if s["direccion"]]


def adivinar_tipo(puertos: list[int], mdns: list[str] | None = None) -> str:
    """Huella del equipo a partir de los puertos que tiene abiertos."""
    p = set(puertos)
    mdns = mdns or []
    if 9223 in p or 38400 in p:
        return "hisense"
    if 5555 in p:
        return "firetv"
    if 62078 in p:
        return "iphone"
    if 1716 in p:
        return "kdeconnect"
    if 80 in p and 443 in p and 8080 in p:
        return "router"
    if any(m.startswith("_googlecast") for m in mdns):
        return "chromecast"
    if any(m.startswith("_airplay") or m.startswith("_raop") for m in mdns):
        return "sonos"
    if any(m.startswith("_ipp") or m.startswith("_printer") for m in mdns):
        return "printer"
    return "host"


# ----------------------------------------------------------------- config


def valor_toml(valor) -> str:
    if isinstance(valor, bool):
        return "true" if valor else "false"
    if isinstance(valor, (int, float)):
        return str(valor)
    if isinstance(valor, (list, tuple)):
        return "[" + ", ".join(valor_toml(v) for v in valor) + "]"
    texto = str(valor).replace("\\", "\\\\").replace('"', '\\"')
    return f'"{texto}"'


def volcar_toml(datos: dict) -> str:
    lineas: list[str] = []
    for seccion, valores in datos.items():
        if not isinstance(valores, dict):
            continue
        simples = {k: v for k, v in valores.items() if not isinstance(v, dict)}
        if simples:
            lineas.append(f"[{seccion}]")
            for clave, valor in simples.items():
                lineas.append(f"{clave} = {valor_toml(valor)}")
            lineas.append("")
        for clave, valor in valores.items():
            if not isinstance(valor, dict):
                continue
            lineas.append(f"[{seccion}.{clave}]")
            for k, v in valor.items():
                lineas.append(f"{k} = {valor_toml(v)}")
            lineas.append("")
    return "\n".join(lineas).rstrip() + "\n"


class Config:
    def __init__(self, ruta: Path = CONFIG_FILE):
        self.ruta = ruta
        self.datos: dict = {"settings": {}, "devices": {}}
        self.cargar()

    def cargar(self) -> None:
        if not self.ruta.exists():
            return
        try:
            with self.ruta.open("rb") as fh:
                self.datos = tomllib.load(fh)
        except (tomllib.TOMLDecodeError, OSError) as exc:
            warn(f"no se pudo leer {self.ruta}: {exc}")
        self.datos.setdefault("settings", {})
        self.datos.setdefault("devices", {})

    def guardar(self) -> None:
        self.ruta.parent.mkdir(parents=True, exist_ok=True)
        self.ruta.write_text(volcar_toml(self.datos), encoding="utf-8")

    @property
    def ajustes(self) -> dict:
        return self.datos.setdefault("settings", {})

    @property
    def dispositivos(self) -> dict:
        return self.datos.setdefault("devices", {})

    def puertos_configurados(self) -> list[int]:
        valor = self.ajustes.get("ports")
        if isinstance(valor, list):
            return [int(p) for p in valor]
        if isinstance(valor, str):
            return [int(p) for p in valor.split(",") if p.strip()]
        return list(PUERTOS_SOSPECHOSOS)


class Dispositivo:
    """Un equipo del inventario, ya resuelto a IP."""

    def __init__(self, clave: str, datos: dict):
        self.clave = clave
        self.datos = datos

    def get(self, item, por_defecto=None):
        return self.datos.get(item, por_defecto)

    @property
    def ip(self) -> str:
        return self.datos.get("ip", "")

    @property
    def tipo(self) -> str:
        return self.datos.get("type", "host")

    @property
    def nombre(self) -> str:
        return self.datos.get("name") or self.clave

    @property
    def puertos(self) -> list[int]:
        return list(self.datos.get("ports", []))


def resolver(config: Config, nombre: str | None, tipo: str | None = None) -> Dispositivo:
    """Busca un dispositivo por clave, nombre o IP; si hay uno solo del tipo, lo usa."""
    dispositivos = config.dispositivos
    if nombre:
        if nombre in dispositivos:
            return Dispositivo(nombre, dispositivos[nombre])
        for clave, datos in dispositivos.items():
            if datos.get("ip") == nombre or str(datos.get("name", "")).lower() == nombre.lower():
                return Dispositivo(clave, datos)
        die(f"no conozco el dispositivo '{nombre}' (usa 'lanctl ls' para ver los)")
    if tipo:
        candidatos = [(k, v) for k, v in dispositivos.items() if v.get("type") == tipo]
        if not candidatos:
            die(f"no hay ningun dispositivo de tipo '{tipo}' en el inventario")
        if len(candidatos) > 1:
            nombres = ", ".join(k for k, _ in candidatos)
            die(f"hay varios dispositivos de tipo '{tipo}' ({nombres}): indica cual con --device")
        clave, datos = candidatos[0]
        return Dispositivo(clave, datos)
    die("indica el dispositivo")


# ------------------------------------------------------- websocket minimo


class Fallo(Exception):
    """Error de red recuperable (se reintenta)."""


class WebSocket:
    """Cliente WebSocket de lo justo: texto, sin TLS, sin extensiones."""

    def __init__(self, url: str, timeout: int = 10, subprotocolos: list[str] | None = None):
        partes = urllib.parse.urlparse(url)
        if partes.scheme != "ws":
            die(f"solo se soportan websockets sin cifrar (ws://), no {partes.scheme}://")
        self.host = partes.hostname or ""
        self.port = partes.port or 80
        self.ruta = partes.path or "/"
        try:
            self.sock = socket.create_connection((self.host, self.port), timeout=timeout)
        except OSError as exc:
            raise Fallo(f"no se pudo conectar a {self.host}:{self.port}: {exc}") from exc
        self.sock.settimeout(timeout)
        clave = base64.b64encode(os.urandom(16)).decode()
        peticion = (
            f"GET {self.ruta} HTTP/1.1\r\n"
            f"Host: {self.host}:{self.port}\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {clave}\r\n"
            "Sec-WebSocket-Version: 13\r\n"
        )
        if subprotocolos:
            peticion += f"Sec-WebSocket-Protocol: {', '.join(subprotocolos)}\r\n"
        peticion += "\r\n"
        self.sock.sendall(peticion.encode())
        buffer = b""
        while b"\r\n\r\n" not in buffer:
            try:
                trozo = self.sock.recv(4096)
            except OSError as exc:
                raise Fallo(f"fallo el saludo websocket: {exc}") from exc
            if not trozo:
                raise Fallo("el servidor corto la conexion en el saludo websocket")
            buffer += trozo
        cabecera = buffer.split(b"\r\n\r\n", 1)[0].decode("latin-1")
        if " 101 " not in cabecera.splitlines()[0] + " ":
            raise Fallo(f"el servidor no acepto el websocket: {cabecera.splitlines()[0]}")

    def _exactos(self, cuantos: int) -> bytes:
        datos = b""
        while len(datos) < cuantos:
            trozo = self.sock.recv(cuantos - len(datos))
            if not trozo:
                raise ConnectionError("conexion cerrada")
            datos += trozo
        return datos

    def enviar(self, datos: bytes, opcode: int = 0x1) -> None:
        mascara = os.urandom(4)
        largo = len(datos)
        cabecera = bytearray([0x80 | opcode])
        if largo < 126:
            cabecera.append(0x80 | largo)
        elif largo < 65536:
            cabecera.append(0x80 | 126)
            cabecera += struct.pack(">H", largo)
        else:
            cabecera.append(0x80 | 127)
            cabecera += struct.pack(">Q", largo)
        cabecera += mascara
        enmascarado = bytes(b ^ mascara[i % 4] for i, b in enumerate(datos))
        self.sock.sendall(bytes(cabecera) + enmascarado)

    def recibir(self) -> tuple[int, bytes]:
        partes = []
        opcode_final = 0
        while True:
            b0, b1 = self._exactos(2)
            fin = bool(b0 & 0x80)
            opcode = b0 & 0x0F
            enmascarado = bool(b1 & 0x80)
            largo = b1 & 0x7F
            if largo == 126:
                largo = struct.unpack(">H", self._exactos(2))[0]
            elif largo == 127:
                largo = struct.unpack(">Q", self._exactos(8))[0]
            mascara = self._exactos(4) if enmascarado else None
            carga = self._exactos(largo) if largo else b""
            if mascara:
                carga = bytes(b ^ mascara[i % 4] for i, b in enumerate(carga))
            if opcode == 0x8:
                raise ConnectionError("el otro extremo cerro la conexion")
            if opcode == 0x9:
                self.enviar(carga, opcode=0xA)
                continue
            if opcode == 0xA:
                continue
            partes.append(carga)
            opcode_final = opcode
            if fin:
                break
        return opcode_final, b"".join(partes)

    def cerrar(self) -> None:
        try:
            self.enviar(b"", opcode=0x8)
        except OSError:
            pass
        finally:
            self.sock.close()


# ------------------------------------------------------------- backend CDP


class CDP:
    """Chrome DevTools Protocol: la via para manejar la TV Hisense (VIDAA)."""

    def __init__(self, host: str, puerto: int = 9223, timeout: int = 12):
        self.host = host
        self.puerto = puerto
        self.timeout = timeout
        self._contador = 0

    def _base(self) -> str:
        return f"http://{self.host}:{self.puerto}"

    def objetivos(self, al_menos_uno: bool = False) -> list[dict]:
        """Lista de objetivos del protocolo.

        Con al_menos_uno=True reintenta hasta que haya alguna pagina: la TV
        deja el target vacio un instante cuando cambia de aplicacion.
        """
        ultimo = ""
        for intento in range(6):
            try:
                datos = http_get(f"{self._base()}/json/list", timeout=self.timeout)
                lista = json.loads(datos)
            except (urllib.error.URLError, OSError, TimeoutError) as exc:
                ultimo = str(exc)
                lista = []
            except json.JSONDecodeError:
                ultimo = "respuesta ilegible"
                lista = []
            if lista or not al_menos_uno:
                return lista
            time.sleep(0.5 * (intento + 1))
        if ultimo:
            die(f"no responde el puerto {self.puerto} de {self.host}: {ultimo}")
        return lista

    def _objetivo(self) -> dict:
        objetivos = self.objetivos(al_menos_uno=True)
        for objetivo in objetivos:
            if objetivo.get("type") == "page" and objetivo.get("webSocketDebuggerUrl"):
                return objetivo
        for objetivo in objetivos:
            if objetivo.get("webSocketDebuggerUrl"):
                return objetivo
        die(f"{self.host} no expone ninguna pagina manejable")

    def _conectar(self, intentos: int = 4) -> WebSocket:
        """Abre el websocket del shell.

        El servidor de la TV a veces contesta 500 si se abre una conexion
        mientras la anterior sigue cerrandose, asi que reintentamos.
        """
        ultimo = ""
        for intento in range(intentos):
            try:
                return WebSocket(self._objetivo()["webSocketDebuggerUrl"],
                                 timeout=self.timeout)
            except Fallo as exc:
                ultimo = str(exc)
                time.sleep(0.4 * (intento + 1))
        die(f"no se pudo abrir el websocket de {self.host}: {ultimo}")

    def _llamar(self, ws: WebSocket, metodo: str, params: dict | None = None) -> dict:
        self._contador += 1
        identificador = self._contador
        ws.enviar(json.dumps({"id": identificador, "method": metodo,
                               "params": params or {}}).encode())
        while True:
            _, carga = ws.recibir()
            try:
                mensaje = json.loads(carga)
            except json.JSONDecodeError:
                continue
            if mensaje.get("id") == identificador:
                return mensaje

    def evaluar(self, expresion: str):
        """Ejecuta JS en el shell de la TV. Devuelve ('ok', valor) o ('error', texto)."""
        ws = self._conectar()
        try:
            respuesta = self._llamar(ws, "Runtime.evaluate", {
                "expression": expresion,
                "returnByValue": True,
                "awaitPromise": True,
            })
        finally:
            ws.cerrar()
        if "error" in respuesta:
            die(f"error del protocolo: {respuesta['error']}")
        resultado = respuesta.get("result", {}).get("result", {})
        if resultado.get("subtype") == "error" or resultado.get("type") == "error":
            return ("error", resultado.get("description", "error desconocido"))
        return ("ok", resultado.get("value"))

    def js(self, expresion: str):
        """Como evaluar(), pero aborta si el JS lanza una excepcion."""
        estado, valor = self.evaluar(expresion)
        if estado == "error":
            die(f"la TV respondio con error: {valor}")
        return valor

    def capturar(self, destino: str) -> str:
        ws = self._conectar()
        try:
            respuesta = self._llamar(ws, "Page.captureScreenshot", {"format": "png"})
        finally:
            ws.cerrar()
        datos = respuesta.get("result", {}).get("data")
        if not datos:
            die("no se pudo capturar la pantalla")
        ruta = Path(destino).expanduser()
        ruta.parent.mkdir(parents=True, exist_ok=True)
        ruta.write_bytes(base64.b64decode(datos))
        return str(ruta)


# ---------------------------------------------------------- backend ADB


class Adb:
    """Mando del Fire TV por ADB sobre TCP."""

    TECLAS = {
        "home": "KEYCODE_HOME", "back": "KEYCODE_BACK", "up": "KEYCODE_DPAD_UP",
        "down": "KEYCODE_DPAD_DOWN", "left": "KEYCODE_DPAD_LEFT",
        "right": "KEYCODE_DPAD_RIGHT", "enter": "KEYCODE_DPAD_CENTER",
        "ok": "KEYCODE_DPAD_CENTER", "menu": "KEYCODE_MENU",
        "play": "KEYCODE_MEDIA_PLAY", "pause": "KEYCODE_MEDIA_PAUSE",
        "play_pause": "KEYCODE_MEDIA_PLAY_PAUSE", "stop": "KEYCODE_MEDIA_STOP",
        "power": "KEYCODE_POWER", "sleep": "KEYCODE_SLEEP",
        "wake": "KEYCODE_WAKEUP", "mute": "KEYCODE_MUTE",
        "volume_up": "KEYCODE_VOLUME_UP", "volume_down": "KEYCODE_VOLUME_DOWN",
        "search": "KEYCODE_SEARCH", "backspace": "KEYCODE_DEL",
        "info": "KEYCODE_INFO", "next": "KEYCODE_MEDIA_NEXT",
        "prev": "KEYCODE_MEDIA_PREVIOUS", "rewind": "KEYCODE_MEDIA_REWIND",
        "fast_forward": "KEYCODE_MEDIA_FAST_FORWARD",
    }

    def __init__(self, dispositivo: Dispositivo):
        self.dispositivo = dispositivo
        self.binario = self._encontrar_adb()
        self.serial = f"{dispositivo.ip}:{dispositivo.get('adb_port', 5555)}"

    @staticmethod
    def _encontrar_adb() -> str:
        # Primero el del sistema, luego el que deja lanctl en ~/.local/lib/lanctl
        # (util cuando no hay permisos de root para instalar android-tools).
        local = Path.home() / ".local" / "lib" / "lanctl" / "adb"
        candidatos = ["adb", "/usr/libexec/android-sdk/platform-tools/adb",
                      "/usr/lib/android-sdk/platform-tools/adb", str(local)]
        for candidato in candidatos:
            if os.path.isabs(candidato):
                if os.access(candidato, os.X_OK):
                    return candidato
            elif shutil.which(candidato):
                return shutil.which(candidato)
        die("falta 'adb'. Instalalo con: sudo dnf install android-tools")

    def _adb(self, *argumentos, timeout: int = 30, binario: bool = False):
        return run([self.binario, "-s", self.serial, *argumentos],
                   timeout=timeout, texto=not binario)

    def conectar(self) -> None:
        proc = run([self.binario, "connect", self.serial], timeout=20)
        salida = ((proc.stdout or "") + (proc.stderr or "")).strip()
        if "unable to connect" in salida.lower():
            die(f"no se pudo conectar al ADB de {self.serial}: {salida}")
        if "unauthorized" in salida.lower():
            die(f"el Fire TV pide autorizacion: acepta en la TV el aviso "
                f"'Allow USB debugging' para {ip_local() or 'este equipo'}")

    def listo(self) -> None:
        """Se asegura de que hay conexion y de que el dispositivo responde."""
        salida = run([self.binario, "devices"], timeout=15).stdout or ""
        if self.serial not in salida:
            self.conectar()
            salida = run([self.binario, "devices"], timeout=15).stdout or ""
        if "unauthorized" in salida:
            die("el Fire TV pide autorizacion: acepta en la TV el aviso de depuracion")

    def shell(self, *comando: str, timeout: int = 30) -> str:
        proc = self._adb("shell", *comando, timeout=timeout)
        if proc.returncode != 0:
            detalle = (proc.stderr or proc.stdout or "").strip()
            die(f"el comando fallo en el Fire TV: {detalle}")
        return (proc.stdout or "").strip()

    def listar_apps(self, solo_terceros: bool = False) -> list[str]:
        args = ["pm", "list", "packages"]
        if solo_terceros:
            args.append("-3")
        apps = []
        for linea in self.shell(*args).splitlines():
            linea = linea.strip()
            if linea.startswith("package:"):
                apps.append(linea.split(":", 1)[1].strip())
        return sorted(apps)

    def lanzar(self, destino: str) -> str:
        if "://" in destino:
            return self.shell("am", "start", "-a", "android.intent.action.VIEW",
                              "-d", destino) or f"abriendo {destino}"
        actividad = self.shell("cmd", "package", "resolve-activity", "--brief",
                                destino).splitlines()
        actividad = [a.strip() for a in actividad if "/" in a]
        if actividad:
            return self.shell("am", "start", "-n", actividad[-1])
        return self.shell("monkey", "-p", destino, "-c",
                          "android.intent.category.LAUNCHER", "1")

    def abrir_url(self, url: str, paquete: str | None = None) -> str:
        """Abre una URL en la app que corresponda (deep link).

        El paquete hay que forzarlo con -p: si no, los enlaces https se los
        queda el navegador Silk en lugar de la app de streaming.
        """
        argumentos = ["am", "start", "-a", "android.intent.action.VIEW", "-d", url]
        if paquete:
            argumentos += ["-p", paquete]
        return self.shell(*argumentos)

    def despierte(self) -> None:
        """Despierta el Stick si esta en reposo (si no, el deep link no se ve)."""
        if "despierta=True" not in self.energia("estado"):
            self.shell("input", "keyevent", "KEYCODE_WAKEUP")
            time.sleep(1.0)

    def teclas(self, accion: str) -> None:
        codigo = self.TECLAS.get(accion.lower())
        if not codigo:
            die(f"tecla desconocida '{accion}'. Conocidas: {', '.join(sorted(self.TECLAS))}")
        self.shell("input", "keyevent", codigo)

    def foco_actual(self) -> str:
        """Paquete de la app que tiene el foco ahora mismo."""
        ventana = self.shell("dumpsys", "window")
        for linea in ventana.splitlines():
            if "mCurrentFocus" in linea:
                return linea.split("u0 ")[-1].split("/")[0].strip()
        return ""

    def esperar_foco(self, paquete: str, segundos: float = 6.0) -> str:
        """Espera a que el paquete indicado tenga el foco."""
        limite = time.time() + segundos
        actual = self.foco_actual()
        while time.time() < limite:
            if actual == paquete:
                return actual
            time.sleep(0.3)
            actual = self.foco_actual()
        return actual

    _CABECERA_SESION = re.compile(r"\((?:userId|uid)=\d+\)")
    _ESTADO = re.compile(r"state=PlaybackState \{state=(\d+)")

    def media_session(self, paquete: str) -> int | None:
        """Estado de la sesion multimedia de un paquete (3 = reproduciendo).

        El formato de 'dumpsys media_session' cambia entre versiones de
        Android: la cabecera de cada sesion puede empezar por el tag o por el
        paquete, llevar un '- ' delante y terminar en '(uid=N)' o en
        '(userId=N)'. Por eso no se busca por prefijo: se corta el volcado en
        bloques (uno por sesion) y se miran los del paquete pedido. Si la app
        tiene varias sesiones, manda la que este reproduciendo.
        """
        volcado = self.shell("dumpsys", "media_session")
        if "Sessions Stack" in volcado:
            volcado = volcado.split("Sessions Stack", 1)[1]
        estados: list[int] = []
        bloque = ""
        for linea in volcado.splitlines():
            if self._CABECERA_SESION.search(linea):
                estados += self._estados_del_bloque(bloque, paquete)
                bloque = linea
            else:
                bloque += "\n" + linea
        estados += self._estados_del_bloque(bloque, paquete)
        if 3 in estados:
            return 3
        return estados[0] if estados else None

    @classmethod
    def _estados_del_bloque(cls, bloque: str, paquete: str) -> list[int]:
        """Estados de un bloque del volcado, si el bloque es de ese paquete."""
        cabecera = bloque.splitlines()[0] if bloque else ""
        del_paquete = re.search(r"(?<![\w.])" + re.escape(paquete) + "/", cabecera)
        if not del_paquete and not re.search(
                r"^package=" + re.escape(paquete) + r"\s*$", bloque, re.MULTILINE):
            return []
        return [int(n) for n in cls._ESTADO.findall(bloque)]

    def esperar_reproduccion(self, paquete: str, segundos: float = 10.0) -> int | None:
        """Espera a que la app empiece a reproducir (estado 3)."""
        limite = time.time() + segundos
        estado = self.media_session(paquete)
        while time.time() < limite:
            if estado == 3:
                return estado
            time.sleep(0.5)
            estado = self.media_session(paquete)
        return estado

    def texto(self, cadena: str) -> None:
        self.shell("input", "text", cadena.replace(" ", "%s"))

    def captura(self, destino: str) -> str:
        proc = self._adb("exec-out", "screencap", "-p", timeout=40, binario=True)
        datos = proc.stdout or b""
        if not datos.startswith(b"\x89PNG"):
            die("el Fire TV no devolvio una imagen valida (pantalla protegida "
                "por DRM, tipo Netflix, o fallo de captura)")
        ruta = Path(destino).expanduser()
        ruta.parent.mkdir(parents=True, exist_ok=True)
        ruta.write_bytes(datos)
        return str(ruta)

    def instalar(self, paquete: str, reemplazar: bool = True) -> str:
        ruta = Path(paquete).expanduser()
        if not ruta.is_file():
            die(f"no encuentro el fichero '{paquete}'")
        argumentos = ["install"]
        if reemplazar:
            argumentos.append("-r")
        argumentos.append(str(ruta))
        proc = self._adb(*argumentos, timeout=600)
        salida = ((proc.stdout or "") + (proc.stderr or "")).strip()
        if "Success" not in salida:
            die(f"la instalacion fallo: {salida}")
        return salida

    def volumen(self, accion: str) -> str:
        if accion in ("up", "down", "mute"):
            self.teclas("mute" if accion == "mute" else f"volume_{accion}")
            return f"volumen: {accion}"
        try:
            nivel = int(accion)
        except ValueError:
            die("volumen: usa up, down, mute o un nivel 0-100")
        salida = self.shell("media", "volume", "--stream", "3", "--set", str(nivel))
        return salida or f"volumen: {nivel}"

    def energia(self, accion: str) -> str:
        if accion == "off":
            self.shell("input", "keyevent", "KEYCODE_SLEEP")
            return "orden de suspension enviada"
        if accion == "on":
            self.shell("input", "keyevent", "KEYCODE_WAKEUP")
            return "orden de despertar enviada"
        estado = self.shell("dumpsys", "power")
        return f"despierta={'mWakefulness=Awake' in estado}"

    PROPS_INTERESANTES = ("ro.product.model", "ro.product.manufacturer",
                           "ro.product.device", "ro.build.version.release",
                           "ro.build.display.id", "ro.serialno",
                           "ro.build.version.sdk", "ro.product.name")

    def estado(self) -> dict:
        """Propiedades del dispositivo (getprop devuelve [clave]: [valor])."""
        info = {}
        for linea in self.shell("getprop").splitlines():
            linea = linea.strip()
            if not (linea.startswith("[") and "]" in linea):
                continue
            clave, _, valor = linea[1:].partition("]")
            clave = clave.strip()
            valor = valor.strip().lstrip(":").strip().strip("[]").strip()
            if clave in self.PROPS_INTERESANTES:
                info[clave] = valor
        return info


# ------------------------------------------------------ backend iOS (usbmux)


class Usbmux:
    """Cliente usbmuxd en TCP: el iPhone expone el puerto 62078 en la wifi."""

    LISTAR = 6
    RESULTADO = 1

    def __init__(self, host: str, puerto: int = 62078, timeout: int = 6):
        self.host = host
        self.puerto = puerto
        self.sock = socket.create_connection((host, puerto), timeout=timeout)
        self.sock.settimeout(timeout)

    def _enviar(self, tipo: int, carga: bytes = b"") -> None:
        cabecera = struct.pack("<IIII", 16 + len(carga), 1, tipo, 1)
        self.sock.sendall(cabecera + carga)

    def _exactos(self, cuantos: int) -> bytes:
        datos = b""
        while len(datos) < cuantos:
            trozo = self.sock.recv(cuantos - len(datos))
            if not trozo:
                raise ConnectionError("conexion cerrada")
            datos += trozo
        return datos

    def _recibir(self) -> tuple[int, bytes]:
        largo, _version, tipo, _etiqueta = struct.unpack("<IIII", self._exactos(16))
        carga = self._exactos(largo - 16) if largo > 16 else b""
        return tipo, carga

    def listar(self) -> list[dict]:
        self._enviar(self.LISTAR)
        for _ in range(5):
            tipo, carga = self._recibir()
            if tipo != self.RESULTADO:
                continue
            try:
                datos = plistlib.loads(carga)
            except Exception:
                return []
            if "DeviceList" in datos:
                return datos.get("DeviceList", [])
            if "Number" in datos:
                return []
        return []

    def cerrar(self) -> None:
        self.sock.close()


class Ios:
    """Control basico de un iPhone via el servicio usbmuxd (puerto 62078).

    Ojo: desde iOS 17 el servicio de red usa RemoteXPC y exige que el
    telefono confie en este equipo (emparejamiento). Si no hay confianza
    el telefono cierra la conexion y no hay nada que hacer por wifi.
    """

    def __init__(self, dispositivo: Dispositivo):
        self.dispositivo = dispositivo
        self.error: str | None = None

    def _usbmux(self) -> Usbmux:
        return Usbmux(self.dispositivo.ip, int(self.dispositivo.get("ios_port", 62078)))

    def listar(self) -> list[dict]:
        """Dispositivos que el telefono expone. [] si no hay confianza."""
        try:
            mux = self._usbmux()
        except OSError as exc:
            self.error = f"no contesta el puerto usbmuxd ({exc})"
            return []
        try:
            return mux.listar()
        except (ConnectionError, OSError, struct.error, plistlib.InvalidFileException) as exc:
            self.error = f"el telefono corta la conexion ({exc})"
            return []
        finally:
            mux.cerrar()

    def _idevice(self, programa: str, *argumentos: str) -> str | None:
        if not tiene(programa):
            return None
        proc = run([programa, *argumentos], timeout=45)
        if proc.returncode != 0:
            return None
        return (proc.stdout or "").strip()

    def estado(self) -> str:
        """Explica que se puede y que no se puede hacer con este iPhone."""
        lineas = [f"iphone {self.dispositivo.ip}:{self.dispositivo.get('ios_port', 62078)}"]
        try:
            dispositivos = self.listar()
        except (OSError, ConnectionError):
            dispositivos = []
        if dispositivos:
            for entrada in dispositivos:
                props = entrada.get("Properties", {})
                lineas.append(
                    f"  udid={props.get('UDID', '?')}  tipo={props.get('ProductID', '?')}  "
                    f"conexion={props.get('ConnectionType', '?')}  "
                    f"serie={props.get('SerialNumber', '?')}"
                )
            return "\n".join(lineas)
        lineas.append(f"  el telefono no acepta el protocolo usbmuxd por wifi"
                      if not self.error else f"  {self.error}")
        lineas.append("  (iOS 17+ pide emparejamiento previo o servicio _remotepairing)")
        lineas.append("  pista: empareja el telefono por USB una vez con")
        lineas.append("        sudo dnf install libimobiledevice-utils && idevicepair")
        return "\n".join(lineas)

    def info(self) -> str:
        lineas = [self.estado()]
        salida = self._idevice("ideviceinfo", "-n")
        if salida:
            lineas.append("")
            lineas.append(salida)
        elif not tiene("ideviceinfo"):
            lineas.append("")
            lineas.append("para mas datos: sudo dnf install libimobiledevice-utils")
        return "\n".join(lineas)

    def captura(self, destino: str) -> str:
        salida = self._idevice("idevicescreenshot", "-n")
        if salida is None:
            die("necesitas 'idevicescreenshot' (sudo dnf install libimobiledevice-utils) "
                "y que el telefono confie en este equipo")
        lineas = [linea.strip() for linea in salida.splitlines() if linea.strip()]
        origen = Path(lineas[-1]) if lineas else None
        if origen is None or not origen.is_file():
            die(f"no se encontro la captura generada ({salida})")
        ruta = Path(destino).expanduser()
        ruta.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(origen, ruta)
        return str(ruta)


# --------------------------------------------------------- backend DLNA


class DLNA:
    """Mandar un video a la TV por UPnP/DLNA (SetAVTransportURI + Play)."""

    def __init__(self, host: str, timeout: int = 8):
        self.host = host
        self.timeout = timeout

    def _descubrir(self) -> dict | None:
        for entrada in buscar_ssdp("urn:schemas-upnp-org:device:MediaRenderer:1", 3.0):
            url = entrada.get("location")
            if not url or self.host not in url:
                continue
            try:
                datos = http_get(url, timeout=self.timeout)
            except (urllib.error.URLError, OSError):
                continue
            try:
                raiz = ET.fromstring(datos)
            except ET.ParseError:
                continue
            for servicio in raiz.iter():
                if not servicio.tag.endswith("service"):
                    continue
                tipo = ""
                control = ""
                for hijo in servicio:
                    tag = hijo.tag.rsplit("}", 1)[-1]
                    if tag == "serviceType":
                        tipo = hijo.text or ""
                    elif tag == "controlURL":
                        control = hijo.text or ""
                if tipo.endswith("AVTransport:1") and control:
                    return {"control": urllib.parse.urljoin(url, control)}
        return None

    def _soap(self, control: str, accion: str, argumentos: dict) -> None:
        cuerpo = [
            '<?xml version="1.0" encoding="utf-8"?>',
            '<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" '
            's:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">',
            "<s:Body>",
            '<u:%s xmlns:u="urn:schemas-upnp-org:service:AVTransport:1">' % accion,
        ]
        for clave, valor in argumentos.items():
            cuerpo.append(f"<{clave}>{valor}</{clave}>")
        cuerpo.append(f"</u:{accion}>")
        cuerpo.append("</s:Body></s:Envelope>")
        http_post(control, "".join(cuerpo).encode("utf-8"), timeout=self.timeout)

    def _metadatos(self, url: str, titulo: str) -> str:
        return (
            '<DIDL-Lite xmlns="urn:schemas-upnp-org:metadata-1-0/DIDL-Lite/" '
            'xmlns:dc="http://purl.org/dc/elements/1.1/" '
            'xmlns:upnp="urn:schemas-upnp-org:metadata-1-0/upnp/">'
            '<item id="0" parentID="0" restricted="1">'
            f"<dc:title>{titulo}</dc:title>"
            "<upnp:class>object.item.videoItem</upnp:class>"
            f'<res protocolInfo="http-get:*:video/mp4:*">{url}</res>'
            "</item></DIDL-Lite>"
        )

    def reproducir(self, url: str, titulo: str = "lanctl") -> str:
        servicio = self._descubrir()
        if not servicio:
            die(f"{self.host} no expone un servicio AVTransport por DLNA")
        control = servicio["control"]
        self._soap(control, "SetAVTransportURI", {
            "InstanceID": "0",
            "CurrentURI": url,
            "CurrentURIMetaData": self._metadatos(url, titulo),
        })
        self._soap(control, "Play", {"InstanceID": "0", "Speed": "1"})
        return f"enviado a {self.host}: {url}"


# -------------------------------------------------------- backend ubus


class Ubus:
    """Router OpenWrt: ubus JSON-RPC 2.0 sobre WebSocket.

    Las credenciales se toman de LANCTL_UBUS_SECRET o, si no esta, del
    fichero ~/.config/lanctl/ubus.secret (modo 600).
    """

    def __init__(self, host: str, usuario: str = "root", secreto: str | None = None):
        self.host = host
        self.usuario = usuario
        self.secreto = secreto or self._buscar_secreto()
        if not self.secreto:
            die("el router necesita credenciales: define LANCTL_UBUS_SECRET "
                f"o crea {SECRETO_FILE} con la contrasena (modo 600)")
        self.sid = ""
        self.ws: WebSocket | None = None
        self._contador = 0

    @staticmethod
    def _buscar_secreto() -> str:
        """Devuelve la contrasena del router, de donde sea que venga."""
        entorno = os.environ.get("LANCTL_UBUS_SECRET")
        if entorno:
            return entorno.strip()
        try:
            return SECRETO_FILE.read_text(encoding="utf-8").strip()
        except OSError:
            return ""

    def _abrir(self) -> WebSocket:
        if self.ws is None:
            try:
                self.ws = WebSocket(f"ws://{self.host}/", timeout=10,
                                    subprotocolos=["ubus-json"])
            except Fallo as exc:
                die(f"no se pudo hablar con el router {self.host}: {exc}")
        return self.ws

    def llamar(self, objeto: str, metodo: str, datos: dict | None = None):
        ws = self._abrir()
        self._contador += 1
        carga = {
            "jsonrpc": "2.0",
            "id": self._contador,
            "method": "call",
            "params": [self.sid, objeto, metodo, datos or {}],
        }
        ws.enviar(json.dumps(carga).encode())
        while True:
            _, respuesta = ws.recibir()
            try:
                mensaje = json.loads(respuesta)
            except json.JSONDecodeError:
                continue
            if mensaje.get("id") == self._contador:
                return mensaje.get("result")

    def entrar(self) -> None:
        # El login de ubus es el objeto "session" con el metodo "login":
        # params = [sid, objeto, metodo, datos].
        credenciales = {"username": self.usuario, PW_KEY: self.secreto}
        resultado = self.llamar("session", "login", credenciales)
        if not isinstance(resultado, list) or not resultado:
            die(f"el router no acepto el inicio de sesion: {resultado}")
        if resultado[0] != 0:
            die(f"el router rechazo las credenciales (codigo {resultado[0]})")
        self.sid = resultado[1].get("ubus_rpc_session", "") if len(resultado) > 1 else ""
        if not self.sid:
            die("el router no devolvio sesion")

    def uci(self, seccion: str, opcion: str | None = None, valor: str | None = None,
            commit: bool = False) -> list:
        if valor is None:
            datos = {"config": seccion}
            if opcion:
                datos["option"] = opcion
        else:
            datos = {"config": seccion, "option": opcion, "value": valor}
        resultado = self.llamar("uci", "set" if valor is not None else "get", datos)
        if commit:
            self.llamar("uci", "commit", {"config": seccion})
        return resultado if isinstance(resultado, list) else [resultado]


# ------------------------------------------------------------- utilidades


def ping_ok(ip: str, timeout: int = 2) -> bool:
    if not ip:
        return False
    proc = run(["ping", "-c", "1", "-W", str(timeout), ip], timeout=timeout + 4)
    return proc.returncode == 0


def vivo(dispositivo: Dispositivo) -> bool:
    """El equipo responde si contesta a alguno de sus puertos conocidos."""
    if not dispositivo.ip:
        return False
    for puerto in dispositivo.puertos[:4]:
        if puerto_abierto(dispositivo.ip, puerto, timeout=0.5):
            return True
    return ping_ok(dispositivo.ip)


# ------------------------------------------------------------ comandos


def cmd_discover(args, config: Config) -> None:
    cidr = args.cidr or config.ajustes.get("cidr") or red_local()
    if args.ports:
        puertos = args.ports
    elif args.rapido:
        puertos = list(PUERTOS_RAPIDOS)
    else:
        puertos = config.puertos_configurados()
    print(f"Escaneando {cidr} ({len(puertos)} puertos)...")
    equipos = escanear_nmap(cidr, puertos)

    # SSDP: encuentra los equipos que no responden a ICMP (la TV Hisense entre ellos)
    for entrada in buscar_ssdp("ssdp:all", 3.0):
        url = entrada.get("location", "")
        for ip in re.findall(r"\d+\.\d+\.\d+\.\d+", url):
            if not any(e["ip"] == ip for e in equipos):
                equipos.append({"ip": ip, "mac": None, "ports": []})

    # A los que han aparecido solo por SSDP se les sondean los puertos clave
    for equipo in equipos:
        if equipo["ports"]:
            continue
        equipo["ports"] = sorted(p for p in PUERTOS_RAPIDOS
                                  if puerto_abierto(equipo["ip"], p, timeout=0.4))

    vecinos = tabla_vecinos()
    nombres_mdns: dict[str, list[str]] = {}
    for servicio in buscar_mdns():
        nombres_mdns.setdefault(servicio["direccion"], []).append(servicio["tipo"])

    encontrados = []
    for equipo in equipos:
        ip = equipo["ip"]
        equipo["mac"] = equipo.get("mac") or vecinos.get(ip)
        equipo["mdns"] = nombres_mdns.get(ip, [])
        equipo["type"] = adivinar_tipo(equipo["ports"], equipo["mdns"])
        encontrados.append(equipo)

    dispositivos = config.dispositivos
    por_ip = {d.get("ip"): k for k, d in dispositivos.items() if d.get("ip")}
    usados = set(dispositivos)
    for equipo in sorted(encontrados, key=lambda e: (e["type"], e["ip"])):
        clave = por_ip.get(equipo["ip"])
        if clave is None:
            base = equipo["type"] if equipo["type"] != "host" else f"host-{equipo['ip'].split('.')[-1]}"
            clave = base
            sufijo = 2
            while clave in usados:
                clave = f"{base}{sufijo}"
                sufijo += 1
        usados.add(clave)
        entrada = dispositivos.setdefault(clave, {})
        entrada["type"] = equipo["type"]
        entrada["ip"] = equipo["ip"]
        if equipo["ports"]:
            entrada["ports"] = equipo["ports"]
        if equipo.get("mac"):
            entrada["mac"] = equipo["mac"]
        if equipo.get("mdns"):
            entrada["mdns"] = equipo["mdns"]
        if not entrada.get("name"):
            entrada["name"] = NOMBRES_TIPO.get(equipo["type"], clave)

    config.guardar()
    filas = []
    for clave, datos in sorted(dispositivos.items(), key=lambda kv: kv[1].get("ip", "")):
        filas.append([
            clave,
            datos.get("ip", "?"),
            datos.get("type", "?"),
            datos.get("name", ""),
            datos.get("mac", ""),
            ",".join(str(p) for p in datos.get("ports", [])),
        ])
    print()
    print(tabla(filas, ["clave", "ip", "tipo", "nombre", "mac", "puertos"]))
    print(f"\nInventario guardado en {config.ruta}")


def cmd_ls(args, config: Config) -> None:
    dispositivos = config.dispositivos
    if not dispositivos:
        print("El inventario esta vacio. Ejecuta 'lanctl discover'.")
        return
    filas = []
    for clave, datos in sorted(dispositivos.items(), key=lambda kv: kv[1].get("ip", "")):
        dispositivo = Dispositivo(clave, datos)
        filas.append([clave, datos.get("ip", "?"), datos.get("type", "?"),
                      datos.get("name", ""), "si" if vivo(dispositivo) else "no"])
    print(tabla(filas, ["clave", "ip", "tipo", "nombre", "vivo"]))


def cmd_status(args, config: Config) -> None:
    dispositivo = resolver(config, args.dispositivo)
    datos = dispositivo.datos
    print(f"{dispositivo.nombre} ({dispositivo.clave})")
    print(f"  tipo    : {dispositivo.tipo}")
    print(f"  ip      : {dispositivo.ip}")
    if datos.get("mac"):
        print(f"  mac     : {datos['mac']}")
    if datos.get("mdns"):
        print(f"  mdns    : {', '.join(datos['mdns'])}")
    if datos.get("model"):
        print(f"  modelo  : {datos['model']}")
    print(f"  puertos : {', '.join(str(p) for p in dispositivo.puertos) or '-'}")
    if datos.get("notes"):
        print(f"  notas   : {datos['notes']}")
    print(f"  estado  : {'en linea' if vivo(dispositivo) else 'sin respuesta (puede estar en suspension)'}")


def cmd_ip(args, config: Config) -> None:
    print(resolver(config, args.dispositivo).ip)


def cmd_ping(args, config: Config) -> None:
    dispositivo = resolver(config, args.dispositivo)
    proc = run(["ping", "-c", str(args.cuenta), dispositivo.ip], timeout=args.cuenta * 2 + 5)
    if proc.stdout:
        print(proc.stdout, end="")
    if proc.stderr:
        print(proc.stderr, end="", file=sys.stderr)
    sys.exit(proc.returncode)


def cmd_ssh(args, config: Config) -> None:
    dispositivo = resolver(config, args.dispositivo)
    usuario = dispositivo.get("ssh_user") or os.environ.get("USER") or "root"
    destino = f"{usuario}@{dispositivo.ip}"
    proc = run(["ssh", "-o", "ConnectTimeout=6", destino, *args.comando], timeout=120)
    if proc.stdout:
        print(proc.stdout, end="")
    if proc.stderr:
        print(proc.stderr, end="", file=sys.stderr)
    sys.exit(proc.returncode)


def cmd_wake(args, config: Config) -> None:
    dispositivo = resolver(config, args.dispositivo)
    mac = dispositivo.get("mac")
    if not mac:
        die(f"no se la MAC de {dispositivo.clave}: ejecuta 'lanctl discover'")
    limpio = mac.replace(":", "").replace("-", "")
    if len(limpio) != 12:
        die(f"MAC con formato inesperado: {mac}")
    paquete = b"\xff" * 6 + bytes.fromhex(limpio) * 16
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.sendto(paquete, ("255.255.255.255", 9))
    finally:
        sock.close()
    print(f"Magic packet enviada a {mac} ({dispositivo.ip})")


def cmd_raw(args, config: Config) -> None:
    dispositivo = resolver(config, args.dispositivo)
    carga = " ".join(args.carga).encode() if args.carga else b""
    if not carga.endswith(b"\n"):
        carga += b"\n"
    try:
        with socket.create_connection((dispositivo.ip, args.puerto), timeout=8) as sock:
            if carga:
                sock.sendall(carga)
            sock.settimeout(4)
            datos = b""
            try:
                while len(datos) < 65536:
                    trozo = sock.recv(4096)
                    if not trozo:
                        break
                    datos += trozo
            except socket.timeout:
                pass
    except OSError as exc:
        die(f"no se pudo conectar a {dispositivo.ip}:{args.puerto}: {exc}")
    sys.stdout.write(datos.decode("utf-8", "replace"))
    sys.stdout.flush()


def cmd_setup(args, config: Config) -> None:
    """Prepara lo que hace falta sin necesidad de root.

    De momento deja el 'adb' de android-tools en ~/.local/lib/lanctl, que es
    lo que necesita el Fire TV. Se hace descargando los RPM y extrayendolos
    con cpio, asi que no hace falta ser root.
    """
    config.ruta.parent.mkdir(parents=True, exist_ok=True)
    print(f"config      : {config.ruta}")

    destino = Path.home() / ".local" / "lib" / "lanctl"
    destino.mkdir(parents=True, exist_ok=True)
    adb = destino / "adb"
    if adb.is_file() and os.access(adb, os.X_OK) and not args.forzar:
        print(f"adb         : ya esta en {adb}")
        return

    if not tiene("dnf"):
        die("necesitas 'dnf' para descargar android-tools")
    if not tiene("cpio") or not tiene("rpm2cpio"):
        die("necesitas 'cpio' y 'rpm2cpio' (sudo dnf install cpio rpm)")

    with tempfile.TemporaryDirectory(prefix="lanctl-adb-") as temporal:
        descargas = Path(temporal) / "rpm"
        descargas.mkdir()
        print("descargando android-tools...")
        proc = run(["dnf", "download", "--resolve", "--alldeps",
                    "--destdir", str(descargas), "android-tools"], timeout=600)
        if proc.returncode != 0:
            die(f"la descarga fallo: {(proc.stderr or '').strip()}\n"
                "prueba con: sudo dnf install android-tools")
        extraido = Path(temporal) / "root"
        extraido.mkdir()
        # Solo interesa el paquete android-tools: el resto son librerias del
        # sistema que ya estan instaladas.
        paquetes = sorted(descargas.glob("android-tools*.rpm")) or sorted(descargas.glob("*.rpm"))
        if not paquetes:
            die("dnf no ha descargado ningun RPM")
        for rpm in paquetes:
            contenido = subprocess.run(["rpm2cpio", str(rpm)], stdout=subprocess.PIPE,
                                       check=False).stdout
            cpio = extraido / "paquete.cpio"
            cpio.write_bytes(contenido)
            with cpio.open("rb") as entrada:
                subprocess.run(["cpio", "-idmu", "--quiet"], cwd=extraido, check=False,
                               stdin=entrada)
            # Algunos RPM traen directorios de solo lectura (p.ej. /usr/bin),
            # y cpio los deja tal cual: hay que poder escribir dentro.
            subprocess.run(["chmod", "-R", "u+rwX", str(extraido)], check=False)
        origen = extraido / "usr" / "bin" / "adb"
        if not origen.is_file():
            die("no se encontro el binario adb en los RPM descargados")
        shutil.copyfile(origen, adb)
        adb.chmod(0o755)

    faltan = [linea.split("=>")[0].strip() for linea
              in (run(["ldd", str(adb)], timeout=20).stdout or "").splitlines()
              if "not found" in linea]
    if faltan:
        die(f"adb necesita librerias que faltan: {', '.join(faltan)}")
    version = (run([str(adb), "version"], timeout=20).stdout or "").strip()
    print(f"adb         : instalado en {adb}")
    if version:
        print(f"             {version.splitlines()[0]}")
    print("para usarlo: deja que el Fire TV acepte 'Allow USB debugging'")


def cmd_doctor(args, config: Config) -> None:
    """Comprueba que esta todo lo necesario para cada backend."""
    print(f"{APP} {VERSION}")
    print(f"  config      : {config.ruta} ({'ok' if config.ruta.exists() else 'aun no existe'})")
    print(f"  ip local    : {ip_local() or '?'}")
    print(f"  red local   : {red_local()}")
    # Para adb/idevice* se miran tambien las copias que deja lanctl en
    # ~/.local/lib/lanctl (util cuando no hay permisos de root para instalar).
    local_lib = Path.home() / ".local" / "lib" / "lanctl"
    herramientas = {
        "nmap": ["nmap"],
        "avahi-browse": ["avahi-browse"],
        "ping": ["ping"],
        "adb": ["adb", "/usr/libexec/android-sdk/platform-tools/adb",
                str(local_lib / "adb")],
        "ideviceinfo": ["ideviceinfo"],
        "idevicescreenshot": ["idevicescreenshot"],
    }
    for nombre, candidatos in herramientas.items():
        encontrado = None
        for candidato in candidatos:
            if os.path.isabs(candidato):
                if os.access(candidato, os.X_OK):
                    encontrado = candidato
                    break
            elif shutil.which(candidato):
                encontrado = shutil.which(candidato)
                break
        print(f"  {nombre:<18}: {encontrado or 'NO INSTALADO'}")
    print()
    for clave, datos in sorted(config.dispositivos.items(), key=lambda kv: kv[1].get("ip", "")):
        dispositivo = Dispositivo(clave, datos)
        estado = "en linea" if vivo(dispositivo) else "sin respuesta"
        print(f"  {clave:<10} {datos.get('ip', '?'):<15} {datos.get('type', '?'):<10} {estado}")
    if Ubus._buscar_secreto():
        origen = "LANCTL_UBUS_SECRET" if os.environ.get("LANCTL_UBUS_SECRET") else SECRETO_FILE
        print(f"\n  backend del router: activo (credenciales en {origen})")
    else:
        print("\n  el backend del router esta desactivado "
              f"(falta LANCTL_UBUS_SECRET o {SECRETO_FILE})")


