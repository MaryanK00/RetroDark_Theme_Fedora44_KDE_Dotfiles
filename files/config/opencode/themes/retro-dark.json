      },
      "blue": {
        "100": "#def8ff",
        "200": "#8cc5ff",
        "300": "#5ba2ef",
        "400": "#287ccf",
        "500": "#0058a8",
        "600": "#003b83",
        "700": "#002459",
        "800": "#000d30",
