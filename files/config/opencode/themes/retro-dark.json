      },
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    },
    "text": {
      "muted": "$hue.neutral.300"
    },
    "diff": {
      "text": {
        "context": "$hue.neutral.300"
      },
      "lineNumber": {
        "background": {
          "added": "#d5e5d5",
          "removed": "#f6dbdb"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.300",
      "keyword": "$hue.accent.300"
    },
    "markdown": {
      "blockQuote": "$hue.neutral.300",
      "heading": "$hue.accent.300",
      "strong": "$hue.accent.400"
    },
    "background": {
      "base": "transparent",
      "raised": {
        "base": "#e4e9ef",
        "high": "#d8dee7",
        "max": "#ccd4df"
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#feffff",
        "200": "#ebeff2",
        "300": "#b8bfc3",
        "400": "#7f888d",
        "500": "#51595f",
        "600": "#2e373c",
