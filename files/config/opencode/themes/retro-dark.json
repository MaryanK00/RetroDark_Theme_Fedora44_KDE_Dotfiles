      },
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    },
    "background": {
      "base": "transparent",
      "raised": {
        "base": "#1a1e26",
        "high": "#232a34",
        "max": "#2d3542"
      }
    }
  }
}
