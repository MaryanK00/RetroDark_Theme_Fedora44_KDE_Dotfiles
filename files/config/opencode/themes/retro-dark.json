        "900": "#ddffff"
      },
      "blue": {
        "100": "#000211",
        "200": "#00397b",
        "300": "#005eae",
        "400": "#237cd2",
        "500": "#4798ee",
        "600": "#6eb5ff",
        "700": "#96d3ff",
        "800": "#bfecff",
        "900": "#e7ffff"
      },
      "purple": {
        "100": "#620003",
        "200": "#740007",
